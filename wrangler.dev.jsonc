{
  // Local-only config for `npm run dev:cloud`: the real Worker + a local (on-disk) D1 database,
  // with sign-in simulated from .dev.vars. Never deployed.
  "name": "expense-calculator-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/login"] },
  "d1_databases": [{ "binding": "DB", "database_name": "expense-calculator-dev", "database_id": "00000000-0000-0000-0000-000000000000" }]
}
